# Avis AI Assistant — Vercel & Local Environment Configuration
# Duplicate this file to .env.local for local development

# ==============================================================================
# Server-Side Provider Credentials (REQUIRED FOR PRODUCTION DEPLOYMENT)
# Set these in Vercel Project Settings -> Environment Variables
# These secrets remain strictly on the serverless side and are NEVER exposed to the client.
# ==============================================================================

# OpenAI API Key (Supports Avis Core GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Preferred OpenAI Model (Defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# Google Gemini API Key (Supports Avis Flash Gemini 1.5/2.5)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key (Supports Avis Analytical Claude 3.5)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================================================
# Client-Side Configuration (Vite)
# ==============================================================================

# Avis Serverless API Endpoint (Defaults to /api/avis/inference)
VITE_AVIS_API_ENDPOINT=/api/avis/inference

# Environment Mode
VITE_AVIS_ENV=production
